{
  "name": "@spec2tools/sdk-tanstack",
  "version": "0.1.0",
  "description": "Create TanStack AI tools from OpenAPI specifications",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "openapi",
    "ai",
    "agent",
    "tools",
    "tanstack",
    "tanstack-ai"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CahidArda/spec2tools.git",
    "directory": "packages/sdk-tanstack"
  },
  "dependencies": {
    "@pydantic/monty": "^0.0.7",
    "@spec2tools/core": "workspace:*",
    "zod-to-json-schema": "^3.24.0"
  },
  "peerDependencies": {
    "@tanstack/ai": "^0.6.3",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
